{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    // Shared packages ship TypeScript source with no build step. This empty
    // task makes a change in a package invalidate the cached typecheck and
    // test results of every app that imports it.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
