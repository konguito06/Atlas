{
  "name": "atlas",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @atlas/desktop tauri dev",
    "dev:mobile": "pnpm --filter @atlas/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "supabase": "3.1.0",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  }
}
